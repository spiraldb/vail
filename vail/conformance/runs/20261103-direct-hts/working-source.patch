+        PreparedCapture::prepare(columns, schema)?,
+        PreparedCapture::prepare(rows, schema)?,
+        PreparedCapture::prepare(globals, schema)?,
+    ];
+    let outer_types = outer_schema
+        .fields()
+        .iter()
+        .map(|field| field.data_type().clone())
+        .collect::<Vec<_>>();
+    let final_type = outer.return_type(&outer_types).ok()?;
+    let DataType::List(item) = &final_type else {
+        return None;
+    };
+    let DataType::Struct(cell) = item.data_type() else {
+        return None;
+    };
+    let [value_field] = cell.as_ref() else {
+        return None;
+    };
+    let projection = crate::PreparedArrayProjection::prepare(
+        &entry_type.to_arrow().ok()?,
+        value_field.data_type(),
+    )
+    .ok()?;
+    Some(SelectedAlignedProgram {
+        entry_argument,
+        entry_type: schema.field(entry_argument).data_type().clone(),
+        program,
+        captures,
+        projection,
+        final_type,
+    })
+}
