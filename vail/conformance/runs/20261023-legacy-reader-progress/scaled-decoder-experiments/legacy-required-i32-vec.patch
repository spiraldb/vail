+#[cfg(test)]
+mod required_i32_sink_tests {
+    use super::*;
+
+    #[test]
+    fn required_vec_list_matches_arrow_builder_and_resets_without_null_children() -> Result<()> {
+        let child = FieldRef::new(arrow_schema::Field::new("item", DataType::Int32, false));
+        let field = arrow_schema::Field::new("array", DataType::List(child.clone()), true);
+        let mut required = Column::List(child.clone(), Box::new(Column::RequiredI32(Vec::new())),
+                                        vec![0], NullBufferBuilder::new(8));
+        let mut ordinary = Column::List(child, Box::new(Column::Int32(Int32Builder::new())),
+                                        vec![0], NullBufferBuilder::new(8));
+        for _ in 0..2 {
+            for payload in [Some(vec![0, 127, 128, 1]), None, Some(vec![]), Some(vec![255, 255, 255, 255, 15])] {
+                for column in [&mut required, &mut ordinary] {
+                    if let Some(bytes) = &payload {
+                        let count = if bytes.len() == 4 { 3 } else if bytes.is_empty() { 0 } else { 1 };
+                        let mut input = Input::from_memory(Arc::from(bytes.clone()), true);
+                        let Column::List(_, values, _, _) = column else { unreachable!() };
+                        match values.as_mut() {
+                            Column::RequiredI32(values) => append_buffered_i32_values(&mut input, values, count)?,
+                            Column::Int32(values) => append_buffered_i32_values(&mut input, values, count)?,
+                            _ => unreachable!(),
+                        }
+                        column.end_list()?;
+                    } else { column.null()?; }
+                }
+            }
+            assert_eq!(required.len(), ordinary.len());
+            let left = required.finish()?;
+            let right = ordinary.finish()?;
+            assert_eq!(left.to_data(), right.to_data());
+            let list = left.as_any().downcast_ref::<ListArray>().unwrap();
+            assert_eq!(list.value_offsets(), &[0, 3, 3, 3, 4]);
+            assert_eq!(list.null_count(), 1);
+            assert_eq!(list.values().null_count(), 0);
+        }
+        // Requiredness is enforced by the sink rather than silently inserting
+        // a null primitive slot when an invalid caller requests one.
+        let Column::List(_, values, _, _) = &mut required else { unreachable!() };
+        assert!(values.null().is_err());
+        let session = vortex::session::VortexSession::default();
+        assert_eq!(required.finish_vortex(&field, &session)?.len(), 0);
+        Ok(())
+    }
+
+    #[test]
+    fn projected_required_varint_lists_choose_vec_only_for_required_leaves() -> Result<()> {
+        let ty = Type::Array { array: Box::new(Type::Primitive(P::Int32)) };
+        for (kind, required) in [("EVarint", true), ("EVarint", false), ("EInt32", true)] {
+            let encoding = Encoding {
+                kind: "EArray2".into(), required: false, rank: 0,
+                fields: vec![("element".into(), Encoding {
+                    kind: kind.into(), required, fields: vec![], rank: 0,
+                })],
+            };
+            let node = Node::new(&encoding, &ty);
+            let mut projected = Column::projected(&node, &ty.to_arrow()?);
+            let Column::List(_, child, _, _) = &projected else { unreachable!() };
+            assert_eq!(matches!(child.as_ref(), Column::RequiredI32(_)), kind == "EVarint" && required);
+            if kind == "EVarint" {
+                let bytes: Arc<[u8]> = if required { Arc::from([2, 128, 1, 7]) }
+                                      else { Arc::from([2, 2, 128, 1]) };
+                let mut ordinary = Column::new(&ty.to_arrow()?);
+                node.append(&mut Input::from_memory(bytes.clone(), false), &mut projected)?;
+                node.append(&mut Input::from_memory(bytes, false), &mut ordinary)?;
+                assert_eq!(projected.finish()?.to_data(), ordinary.finish()?.to_data());
+            }
+        }
+        Ok(())
+    }
+
+    #[test]
+    fn required_vec_sink_matches_builder_errors_and_consumption() -> Result<()> {
+        for bytes in [vec![1, 2, 3, 128], vec![1, 2, 3, 128, 128, 128, 128, 16],
+                      [vec![1, 2, 3], vec![128; 11]].concat()] {
+            for prefix in [0, 65_535] {
+                let mut data = vec![0; prefix];
+                data.extend_from_slice(&bytes);
+                let data: Arc<[u8]> = data.into();
+                let mut left = Input::from_memory(data.clone(), true);
+                let mut right = Input::from_memory(data, true);
+                left.skip(prefix)?;
+                right.skip(prefix)?;
+                let mut required = Vec::new();
+                let mut ordinary = Int32Builder::new();
+                let a = append_buffered_i32_values(&mut left, &mut required, 4);
+                let b = append_buffered_i32_values(&mut right, &mut ordinary, 4);
+                assert_eq!(a.err().map(|e| e.to_string()), b.err().map(|e| e.to_string()));
+                assert_eq!(left.bytes, right.bytes);
+                assert_eq!(required.as_slice(), ordinary.values_slice());
+            }
+        }
+        Ok(())
+    }
+}
