+fn decode_required_list<const MODE: u8>(
+    input: &mut Input,
+    list: &mut BoundList<'_, Vec<i32>>,
+) -> Result<()> {
+    let count = bound_list_length::<MODE>(input)?;
+    append_buffered_i32_values(input, list.values, count)?;
+    list.offsets.push(i32::try_from(list.values.len())?);
+    list.validity.append_non_null();
+    Ok(())
+}
+trait I32Sink {
+    fn push_i32(&mut self, value: i32);
+}
+impl I32Sink for Int32Builder {
+    #[inline(always)]
+    fn push_i32(&mut self, value: i32) { self.append_value(value); }
+}
+impl I32Sink for Vec<i32> {
+    #[inline(always)]
+    fn push_i32(&mut self, value: i32) { self.push(value); }
+}
+
+#[inline(always)]
+fn append_buffered_i32_values<S: I32Sink>(
+    input: &mut Input,
+    output: &mut S,
+    count: usize,
+) -> Result<()> {
+    if count <= 3 {
+        for _ in 0..count {
+            let value = input.varint(64)?;
+            if value > u32::MAX as u64 {
+                return Err("Hail int32 varint overflow".into());
+            }
+            output.push_i32(value as u32 as i32);
+        }
+        Ok(())
+    } else {
+        append_buffered_large_i32_values(input, output, count)
+    }
+}
