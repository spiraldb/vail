+/// Fixed-capacity owned buffer. Refill stays outside the per-byte decoder;
+/// all positions are checked and this adapter contains no unsafe access.
+struct ReadBuffer {
+    source: Stream,
+    data: Box<[u8]>,
+    pos: usize,
+    end: usize,
+}
+impl ReadBuffer {
+    fn with_capacity(capacity: usize, source: Stream) -> Self {
+        Self {
+            source,
+            data: vec![0; capacity.max(1)].into_boxed_slice(),
+            pos: 0,
+            end: 0,
+        }
+    }
+    #[inline(never)]
+    fn refill(&mut self) -> io::Result<()> {
+        debug_assert_eq!(self.pos, self.end);
+        self.pos = 0;
+        self.end = 0;
+        loop {
+            match self.source.read(&mut self.data) {
+                Err(error) if error.kind() == io::ErrorKind::Interrupted => continue,
+                result => {
+                    self.end = result?;
+                    return Ok(());
+                }
+            }
+        }
+    }
+}
+impl BufRead for ReadBuffer {
+    #[inline(always)]
+    fn fill_buf(&mut self) -> io::Result<&[u8]> {
+        if self.pos == self.end {
+            self.refill()?;
+        }
+        Ok(&self.data[self.pos..self.end])
+    }
+    #[inline(always)]
+    fn consume(&mut self, amount: usize) {
+        self.pos += amount.min(self.end - self.pos);
+    }
+}
+impl Read for ReadBuffer {
+    fn read(&mut self, output: &mut [u8]) -> io::Result<usize> {
+        if output.is_empty() {
+            return Ok(0);
+        }
+        if self.pos == self.end && output.len() >= self.data.len() {
+            return self.source.read(output);
+        }
+        let available = self.fill_buf()?;
+        let count = available.len().min(output.len());
+        output[..count].copy_from_slice(&available[..count]);
+        self.pos += count;
+        Ok(count)
+    }
+}
