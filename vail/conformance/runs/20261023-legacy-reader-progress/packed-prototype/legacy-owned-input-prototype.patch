+    #[test]
+    fn owned_buffer_matches_standard_reader_across_capacities() -> Result<()> {
+        for capacity in [1usize, 2, 7, 64, 65536] {
+            let bytes = (0..257).map(|i| (i % 251) as u8).collect::<Vec<_>>();
+            let mut owned =
+                ReadBuffer::with_capacity(capacity, Box::new(Cursor::new(bytes.clone())));
+            let mut standard = BufReader::with_capacity(capacity, Cursor::new(bytes));
+            for size in [0usize, 1, 4, 8, 3, 16, 0, 65, 2, 128, 64] {
+                let mut actual = vec![0; size];
+                let mut expected = vec![0; size];
+                let actual_result = owned.read_exact(&mut actual);
+                let expected_result = standard.read_exact(&mut expected);
+                assert_eq!(actual_result.is_ok(), expected_result.is_ok());
+                assert_eq!(actual, expected, "capacity={capacity} size={size}");
+                if actual_result.is_err() {
+                    break;
+                }
+                assert_eq!(owned.fill_buf()?, standard.fill_buf()?);
+                let consume = owned.fill_buf()?.len().min(1);
+                owned.consume(consume);
+                standard.consume(consume);
+            }
+        }
+        Ok(())
+    }
+
+    #[test]
+    fn owned_buffer_preserves_mixed_reads_and_partial_accounting() -> Result<()> {
+        let mut bytes = vec![7];
+        bytes.extend(77i32.to_le_bytes());
+        bytes.extend([4, 5, 6, 88, 99, 9]);
+        let mut input = buffered(bytes);
+        assert_eq!(input.byte()?, 7);
+        assert_eq!(i32::from_le_bytes(input.fixed()?), 77);
+        assert_eq!(input.bytes(3)?, vec![4, 5, 6]);
+        input.skip(2)?;
+        assert_eq!(input.byte()?, 9);
+        assert_eq!(input.bytes, 11);
+        input.finish()?;
+        let mut input = buffered(vec![1]);
+        assert!(input.bytes(3).is_err());
+        assert_eq!(input.bytes, 1);
+        let mut input = buffered(vec![1, 2]);
+        assert!(input.fixed::<4>().is_err());
+        assert_eq!(input.bytes, 0);
+        let mut input = buffered(vec![1, 2]);
+        assert!(input.skip(3).is_err());
+        assert_eq!(input.bytes, 2);
+        assert!(buffered(vec![42]).finish().is_err());
+        Ok(())
+    }
