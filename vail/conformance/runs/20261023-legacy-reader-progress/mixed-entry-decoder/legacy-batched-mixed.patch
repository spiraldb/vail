+                    for _ in 0..bad_row { entry(3, 2, 0, mode, &mut bytes); }
+                    let mut broken = Vec::new();
+                    entry(3, 2, 0, mode, &mut broken);
+                    broken.truncate(broken.len() - 2); // replace final DP=257
+                    bytes.extend(broken);
