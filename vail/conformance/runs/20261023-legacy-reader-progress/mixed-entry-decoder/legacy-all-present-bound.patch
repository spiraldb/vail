+        let (ty, _) = Parser::new(
+            "Struct{a:Int32,b:Int32,c:Int32,values:Array[Int32],tail:Int32}",
+            &refs,
+        )
+        .virtual_type()?;
+        let datatype = ty.to_arrow()?;
+        for leb in [false, true] {
+            for projected in [false, true] {
+                let mut node = Node::new(&encoding, &ty);
+                if projected {
+                    node.demand(&[vec!["a".into()], vec!["values".into()]]);
+                }
+                for (missing, payload) in [
+                    (0_u8, vec![1, 2, 3, 2, 128, 1, 5, 7]),
+                    (0_u8, vec![1, 128, 1, 3, 0, 7]),
+                    (10_u8, vec![1, 3, 7]),
+                ] {
+                    for truncate in [false, true] {
+                        let payload = if truncate {
+                            &payload[..payload.len() - 1]
+                        } else {
+                            &payload[..]
+                        };
+                        for present_path in [false, true] {
+                            if present_path && missing != 0 {
+                                continue;
+                            }
+                            let mut input = Input::from_memory(Arc::from(payload), leb);
+                            let mut column = Column::projected(&node, &datatype);
+                            let Column::Struct(_, outputs, validity) = &mut column else {
+                                unreachable!()
+                            };
+                            let mut ops = node.bind_struct(outputs, leb);
+                            let mut bitmap_bytes = [0_u8; 8];
+                            bitmap_bytes[0] = missing;
+                            let bits = Bitmap::Inline(bitmap_bytes);
+                            let result = (|| -> Result<()> {
+                                for op in &mut ops {
+                                    if present_path {
+                                        op.append::<true>(&mut input, &bits)?;
+                                    } else {
+                                        op.append::<false>(&mut input, &bits)?;
+                                    }
+                                }
+                                validity.append_non_null();
+                                Ok(())
+                            })();
+                            drop(ops);
+                            let mut encoded = vec![missing];
+                            encoded.extend_from_slice(payload);
+                            let mut reference_input = Input::from_memory(encoded.into(), leb);
+                            let mut reference = Column::projected(&node, &datatype);
+                            let expected = node.append(&mut reference_input, &mut reference);
+                            assert_eq!(result.is_ok(), expected.is_ok());
+                            assert_eq!(input.bytes + 1, reference_input.bytes);
+                            if result.is_ok() {
+                                assert_eq!(
+                                    column.finish()?.to_data(),
+                                    reference.finish()?.to_data()
+                                );
+                            } else {
+                                assert_eq!(
+                                    result.unwrap_err().to_string(),
+                                    expected.unwrap_err().to_string()
+                                );
+                            }
+                        }
+                    }
+                }
+            }
+        }
+        Ok(())
+    }
