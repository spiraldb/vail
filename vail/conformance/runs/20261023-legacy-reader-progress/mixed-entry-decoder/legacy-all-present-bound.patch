 #[cfg(test)]
 mod tests {
+    #[test]
+    fn bound_run_codec_is_resolved_before_rows() -> Result<()> {
+        let refs = std::collections::HashMap::new();
+        let encoding = Parser::new("+EBaseStruct{a:EInt32,b:EInt64,c:EInt32}", &refs).encoded()?;
+        let (ty, _) = Parser::new("Struct{a:Int32,b:Int64,c:Int32}", &refs).virtual_type()?;
+        let node = Node::new(&encoding, &ty);
+        let datatype = ty.to_arrow()?;
+        for leb in [false, true] {
+            for missing in [0u8, 2] {
+                let mut payload = vec![];
+                for (index, value) in [1i64, 300, -1].into_iter().enumerate() {
+                    if missing & (1 << index) != 0 {
+                        continue;
+                    }
+                    if leb {
+                        let mut value = if index == 1 {
+                            value as u64
+                        } else {
+                            value as u32 as u64
+                        };
+                        loop {
+                            let byte = (value & 127) as u8;
+                            value >>= 7;
+                            payload.push(byte | if value == 0 { 0 } else { 128 });
+                            if value == 0 {
+                                break;
+                            }
+                        }
+                    } else if index == 1 {
+                        payload.extend_from_slice(&value.to_le_bytes());
+                    } else {
+                        payload.extend_from_slice(&(value as i32).to_le_bytes());
+                    }
+                }
+                for truncate in [false, true] {
+                    let bytes = if truncate {
+                        &payload[..payload.len() - 1]
+                    } else {
+                        &payload[..]
+                    };
+                    let mut column = Column::projected(&node, &datatype);
+                    let Column::Struct(_, outputs, validity) = &mut column else {
+                        unreachable!()
+                    };
+                    let mut ops = node.bind_struct(outputs, leb);
+                    assert_eq!(ops.iter().any(|op| matches!(op, BoundOp::Run { .. })), leb);
+                    let mut bitmap = [0u8; 8];
+                    bitmap[0] = missing;
+                    let bits = Bitmap::Inline(bitmap);
+                    let mut input = Input::from_memory(Arc::from(bytes), leb);
+                    let actual = (|| -> Result<()> {
+                        for op in &mut ops {
+                            if missing == 0 {
+                                op.append::<true>(&mut input, &bits)?;
+                            } else {
+                                op.append::<false>(&mut input, &bits)?;
+                            }
+                        }
+                        validity.append_non_null();
+                        Ok(())
+                    })();
+                    drop(ops);
+                    let mut whole = vec![missing];
+                    whole.extend_from_slice(bytes);
+                    let mut reference_input = Input::from_memory(whole.into(), leb);
+                    let mut reference = Column::projected(&node, &datatype);
+                    let expected = node.append(&mut reference_input, &mut reference);
+                    assert_eq!(actual.is_ok(), expected.is_ok());
+                    assert_eq!(input.bytes + 1, reference_input.bytes);
+                    if actual.is_ok() {
+                        assert_eq!(column.finish()?.to_data(), reference.finish()?.to_data());
+                    } else {
+                        assert_eq!(
+                            actual.unwrap_err().to_string(),
+                            expected.unwrap_err().to_string()
+                        );
+                    }
+                }
+            }
+        }
+        Ok(())
+    }
