  "original_function": "def test_gnomad_coverage_stats_optimized(gnomad_dp_sim):\n    mt = hl.read_matrix_table(str(gnomad_dp_sim))\n    mt = mt.annotate_rows(mean=hl.agg.mean(mt.x), count_array=hl.rbind(hl.agg.counter(hl.min(100, mt.x)), lambda c: hl.range(0, 100).map(lambda i: c.get(i, 0))))\n    mt = mt.annotate_rows(median=hl.rbind(hl.sum(mt.count_array) / 2, lambda s: hl.find(lambda x: x > s, hl.array_scan(lambda i, j: i + j, 0, mt.count_array))), **{f'above_{x}': hl.sum(mt.count_array[x:]) for x in [1, 5, 10, 15, 20, 25, 30, 50, 100]})\n    mt.rows()._force_count()",
