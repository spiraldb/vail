     /// Returns the underlying data of this array
     fn to_data(&self) -> ArrayData;
 
+    /// Visits retained buffers for physical memory accounting without requiring
+    /// a materialized logical representation. Visitors may observe shared buffers
+    /// more than once and should deduplicate allocations when appropriate.
+    fn visit_buffers(&self, visitor: &mut dyn FnMut(&Buffer)) {
+        fn visit(data: &ArrayData, visitor: &mut dyn FnMut(&Buffer)) {
+            for buffer in data.buffers() {
+                visitor(buffer);
+            }
+            if let Some(nulls) = data.nulls() {
+                visitor(nulls.inner().inner());
+            }
+            for child in data.child_data() {
+                visit(child, visitor);
+            }
+        }
+        visit(&self.to_data(), visitor);
+    }
+
