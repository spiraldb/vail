  "comparison": "Base Python type wrappers versus final Python on the same final native extension. This isolates Python traversal/getter changes and is not an old-native comparison.",
  "child_source": "import time,tracemalloc,json\nimport vail as hl\nfrom vail.types import infer_type,unify_types\nWIDTH=WIDTH_VALUE\nMODE=MODE_VALUE\nif MODE=='unify':\n a=hl.tstruct(**{f'f{i}':hl.tint32 for i in range(WIDTH)})\n b=hl.tstruct(**{f'f{i}':hl.tint64 for i in range(WIDTH)})\n def run():\n  result=unify_types(a,b)\n  assert len(result)==WIDTH and result['f0']==hl.tint64\nelif MODE=='key_access':\n a=hl.tdict(hl.tstr,hl.tstruct(**{f'f{i}':hl.tint32 for i in range(WIDTH)}))\n def run():\n  for _ in range(100): assert a.key_type==hl.tstr\nelif MODE=='infer':\n a=list(range(WIDTH))\n infer_type(0)  # exclude one-time NumPy import from temporary inference cost\n def run(): assert infer_type(a)==hl.tarray(hl.tint32)\nelse:\n a=hl.tstruct(**{f'f{i}':hl.tint32 for i in range(WIDTH)})\n def run():\n  t=hl.range_table(1).annotate(k=hl.missing(a)).key_by('k')\n  assert t.count()==1\ntracemalloc.start();t=time.perf_counter();run();elapsed=time.perf_counter()-t\nprint(json.dumps(dict(seconds=elapsed,python_peak_bytes=tracemalloc.get_traced_memory()[1])))\n",
