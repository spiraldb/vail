{
  "base_commit": "b8f9e42c",
  "comparison": "Independent complete baseline Python/native snapshot versus final release. Matching inputs/public actions in fresh processes.",
  "baseline_native_sha256": "530a6998afbfe4a4660b94c723e0b46c2b5585c00428317673ea12b9aa634b09",
  "native_sha256": "b2e1ae668c7c992c87bdf2bfbb5cbee53bbcf070445db689f89944d298ad845f",
  "child_source": "import json,time,resource\nimport vail as hl\nMODE=MODE_VALUE\nN=N_VALUE\nR=R_VALUE\nW=W_VALUE\nhl.reset_global_randomness()\nif MODE=='storage':\n import pyarrow as pa\n t=hl.Table.parallelize(pa.table({'a':pa.array([['a',None,'b'],[],None],type=pa.list_(pa.large_string())),\n                                  'zero':pa.array(['z0','z1','z2'],type=pa.large_string())}))\n e=t.a.scan(lambda acc,item:hl.if_else(hl.is_missing(item),acc,item),t.zero)\nelif MODE in ['zip','enumerate','arithmetic','corr','mean','median','set_median']:\n values=[float((i*8191)%N) for i in range(N)]\n t=hl.Table.parallelize([{'x':values,'y':[2*x+1 for x in values]}],schema=hl.tstruct(x=hl.tarray(hl.tfloat64),y=hl.tarray(hl.tfloat64)))\n if MODE=='zip': e=hl.zip(t.x,t.y)\n elif MODE=='enumerate':e=hl.enumerate(t.x)\n elif MODE=='arithmetic':e=t.x+t.y\n elif MODE=='corr':e=hl.corr(t.x,t.y)\n elif MODE=='mean':e=hl.mean(t.x)\n elif MODE=='median':e=hl.median(t.x)\n else:e=hl.median(hl.set(t.x))\nelif MODE=='capture':\n t=hl.Table.parallelize([{'a':list(range(N)),'c':[i]*W} for i in range(R)],\n   schema=hl.tstruct(a=hl.tarray(hl.tint32),c=hl.tarray(hl.tint32)))\n e=t.a.fold(lambda acc,item:acc+item+t.c[0],0)\nelif MODE in ['state','state_scan']:\n t=hl.Table.parallelize([{'a':list(range(N)),'state':[i]*W} for i in range(R)],\n   schema=hl.tstruct(a=hl.tarray(hl.tint32),state=hl.tarray(hl.tint32)))\n e=t.a.fold(lambda acc,item:acc,t.state) if MODE=='state' else t.a.scan(lambda acc,item:acc,t.state).length()\nelif MODE=='scalar':\n t=hl.range_table(R,1);a=hl.literal(list(range(N)))\n e=a.fold(lambda acc,item:acc+item+t.idx,0)\nelif MODE=='rng_zip':\n a=hl.range(N).map(lambda i:hl.rand_unif(seed=13));e=hl.zip(a,list(range(N)))\nt=time.perf_counter();actual=e.collect() if MODE!='rng_zip' else hl.eval(e);elapsed=time.perf_counter()-t\nif MODE=='storage':assert actual==[['z0','a','a','b'],['z1'],None]\nelif MODE=='zip':assert len(actual[0])==N and actual[0][0]==(values[0],2*values[0]+1)\nelif MODE=='enumerate':assert actual[0]==list(enumerate(values))\nelif MODE=='arithmetic':assert actual[0]==[3*x+1 for x in values]\nelif MODE=='corr':assert abs(actual[0]-1)<1e-10\nelif MODE=='mean':assert actual==[(N-1)/2]\nelif MODE in ['median','set_median']:assert actual==[float((N-1)//2)]\nelif MODE=='capture':assert actual==[N*(N-1)//2+N*i for i in range(R)]\nelif MODE=='scalar':assert actual==[N*(N-1)//2+N*i for i in range(R)]\nelif MODE=='state':assert actual==[[i]*W for i in range(R)]\nelif MODE=='state_scan':assert actual==[N+1]*R\nelif MODE=='rng_zip':assert len(actual)==N\nprint(json.dumps(dict(action_seconds=elapsed,peak_rss_bytes=resource.getrusage(resource.RUSAGE_SELF).ru_maxrss)))\n",
  "timeout_seconds": 10,
